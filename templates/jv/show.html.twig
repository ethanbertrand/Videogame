{% extends 'base.html.twig' %}

{% block title %}JV{% endblock %}

{% block body %}
    <h1>JV</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ j_v.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ j_v.titre }}</td>
            </tr>
            <tr>
                <th>Date_Sortie</th>
                <td>{{ j_v.DateSortie ? j_v.DateSortie|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ j_v.description }}</td>
            </tr>
            <tr>
                <th>Detail</th>
                <td>{{ j_v.Detail }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_j_v_index') }}">back to list</a>

    <a href="{{ path('app_j_v_edit', {'id': j_v.id}) }}">edit</a>

    {{ include('jv/_delete_form.html.twig') }}
{% endblock %}
